#!/bin/bash

# Generate the ed25519 keypair the resolver signs with and clients pin.
#
# The private key is the most sensitive thing in this system. Whoever holds it
# can tell every client to install anything, as root, and the client will
# believe it. Treat it like a package signing key, because that is what it is.

set -euo pipefail

OUT="${1:-./resolver-key}"

if [[ -e "$OUT" ]]; then
  echo "refusing to overwrite existing key: $OUT" >&2
  echo "every client pinning the matching public key would stop trusting the" >&2
  echo "resolver the moment it started signing with a new one." >&2
  exit 1
fi

umask 077
openssl genpkey -algorithm ed25519 -out "$OUT"
umask 022
openssl pkey -in "$OUT" -pubout -out "$OUT.pub"
chmod 600 "$OUT"
chmod 644 "$OUT.pub"

echo "private key: $OUT      (server only, never distribute)"
echo "public key:  $OUT.pub  (pin this on every client)"
echo ""
echo "Serve with:"
echo "  SIGNING_KEY=$OUT python3 server/resolve.py"
echo ""
echo "Pin on a client:"
echo "  install -Dm644 $OUT.pub ~/.config/omarchy/resolver.pub"
