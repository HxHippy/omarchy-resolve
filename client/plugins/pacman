#!/bin/bash
# Arch's native package manager. The default route on Omarchy.
set -euo pipefail
case "${1:-}" in
probe)     command -v pacman >/dev/null ;;
installed) shift; pacman -Qq -- "$1" >/dev/null 2>&1 ;;
install)   shift; exec sudo pacman -S --needed --noconfirm -- "$@" ;;
remove)    shift; exec sudo pacman -Rns --noconfirm -- "$@" ;;
*) echo "usage: pacman probe|installed|install|remove" >&2; exit 1 ;;
esac
