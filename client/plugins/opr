#!/bin/bash
# The guaranteed tier: packages we built, signed and serve ourselves.
# Probing requires the repo to actually be configured, otherwise pacman would
# resolve the name from the official repos and the trust label would be a lie.
set -euo pipefail

repo_name() {
  grep -oE '^\[(omarchy|omarchy-test)\]' /etc/pacman.conf 2>/dev/null | head -1 | tr -d '[]'
}

case "${1:-}" in
probe)
  command -v pacman >/dev/null || exit 1
  [[ -n "$(repo_name)" ]]
  ;;
installed) shift; pacman -Qq -- "$1" >/dev/null 2>&1 ;;
install)
  shift
  repo=$(repo_name)
  [[ -n "$repo" ]] || { echo "no omarchy repo in pacman.conf" >&2; exit 1; }
  # Qualify with the repo so this really installs our build and not a
  # same-named package from extra.
  exec sudo pacman -S --needed --noconfirm -- "${@/#/$repo/}"
  ;;
remove)    shift; exec sudo pacman -Rns --noconfirm -- "$@" ;;
*) echo "usage: opr probe|installed|install|remove" >&2; exit 1 ;;
esac
