#!/bin/bash
set -euo pipefail
case "${1:-}" in
probe)     command -v apt-get >/dev/null ;;
installed) shift; dpkg -s "$1" >/dev/null 2>&1 ;;
install)   shift; sudo apt-get update -qq; exec sudo apt-get install -y -- "$@" ;;
remove)    shift; exec sudo apt-get remove -y --auto-remove -- "$@" ;;
*) echo "usage: apt probe|installed|install|remove" >&2; exit 1 ;;
esac
